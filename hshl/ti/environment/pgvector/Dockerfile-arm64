# Basis-Image
FROM imresamu/postgis-arm64:17-3.5-bookworm

LABEL maintainer="stuckenholz"

# Install necessary packages - explizit PG17 dev package
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        postgresql-server-dev-17 \
    && rm -rf /var/lib/apt/lists/*

# Install pgvector v0.8.2 - explizit PG17 pg_config verwenden
RUN cd /tmp && \
    git clone --branch v0.8.2 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config && \
    make install PG_CONFIG=/usr/lib/postgresql/17/bin/pg_config && \
    cd / && \
    rm -rf /tmp/pgvector

# Extension beim DB-Start aktivieren
RUN echo "CREATE EXTENSION IF NOT EXISTS vector;" > /docker-entrypoint-initdb.d/pgvector.sql