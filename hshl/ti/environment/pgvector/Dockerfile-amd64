# Basis-Image – PostgreSQL 17 + PostGIS 3.5, gepinnt auf Debian Bookworm
FROM postgis/postgis:17-3.5

LABEL maintainer="stuckenholz"

# Install necessary packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        git \
        build-essential \
        postgresql-server-dev-all \
    && rm -rf /var/lib/apt/lists/*

# Install pgvector v0.8.2 (PostgreSQL 17 kompatibel, fixes CVE-2026-3172)
RUN cd /tmp && \
    git clone --branch v0.8.2 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make && \
    make install && \
    cd / && \
    rm -rf /tmp/pgvector

# Extension beim DB-Start aktivieren
RUN echo "CREATE EXTENSION IF NOT EXISTS vector;" > /docker-entrypoint-initdb.d/pgvector.sql