    {
      "id": "a472c6fc-d5b9-4864-877d-d971fe1ec558",
      "name": "Anmeldung prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "pythonNative",
        "pythonCode": "# Modus \"Run Once for Each Item\"\n# Prüfungen der Anmeldung der Reihe nach, wie in einem Entscheidungsbaum:\n# Die erste Prüfung, die fehlschlägt, bestimmt den Ablehnungsgrund.\nfrom datetime import date, timedelta\n\na = _item[\"json\"]\n\ndef ergebnis(ok, grund=\"\"):\n    return {\"json\": {**a, \"ok\": ok, \"grund\": grund}}\n\n# 1. Pflichtangaben vorhanden?\nfor feld in [\"nachricht_id\", \"malo_id\", \"lieferbeginn\", \"lfn\"]:\n    if not a.get(feld):\n        return ergebnis(False, \"Pflichtangabe fehlt: \" + feld)\n\n# 2. Liefertermin frühestens am nächsten Werktag? (Feiertage ignoriert)\ntry:\n    termin = date.fromisoformat(a[\"lieferbeginn\"])\nexcept ValueError:\n    return ergebnis(False, \"Liefertermin ungültig\")\nfrueh = date.today() + timedelta(days=1)\nwhile frueh.weekday() >= 5:  # 5 = Samstag, 6 = Sonntag\n    frueh += timedelta(days=1)\nif termin < frueh:\n    return ergebnis(False, \"Liefertermin zu früh\")\n\n# 3. Marktlokation bekannt?\nif not a[\"malo_bekannt\"]:\n    return ergebnis(False, \"MaLo-ID unbekannt\")\n\n# 4. Termin noch frei?\nif a[\"termin_belegt\"]:\n    return ergebnis(False, \"Konkurrierende Anmeldung\")\n\nreturn ergebnis(True)\n"
      }
    },
